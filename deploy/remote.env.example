# 线上部署配置（复制为 deploy/remote.env 后修改；该文件已被 .gitignore 忽略）
# 本地构建镜像后，通过 SSH 流式传输到服务器并在服务器上重建容器。
# 服务器只需安装 Docker 并允许 SSH 登录，无需项目源码。

# 目标服务器（格式 user@host）
SSH_HOST=root@192.168.1.10

# SSH 端口
SSH_PORT=22

# SSH 私钥（可选，默认使用 ssh-agent 或 ~/.ssh 下的默认密钥）
# SSH_KEY=C:/Users/me/.ssh/id_ed25519

# 服务器上的临时目录（存放部署脚本与 env 文件）
# REMOTE_DIR=/tmp/kb-chatbot-deploy

# 线上容器的宿主机端口（不填则继承线上旧容器）
# HOST_PORT=3000
