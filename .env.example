# OpenAI 兼容接口（默认 DeepSeek，可换成 OpenAI / 通义 / Kimi 等）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=你的密钥
LLM_MODEL=deepseek-chat
PORT=3000

# SQLite 数据目录（默认 ./data）。容器部署时指向挂载卷，如 /app/data
# DATA_DIR=./data

# 日志级别：debug | info | warn | error（默认 info）；日志文件见 logs/app-YYYY-MM-DD.log
LOG_LEVEL=info

# 单个上传文件大小上限（MB，默认 100）
# MAX_UPLOAD_MB=100

# 文本/URL 入库的 JSON 请求体上限（MB，默认 30）
# MAX_JSON_BODY_MB=30

# 文件解析 worker：并发数（默认 1）、单 worker 内存上限（MB，默认 768）、超时（毫秒，默认 300000）
# PARSER_CONCURRENCY=1
# PARSER_MEMORY_MB=768
# PARSER_TIMEOUT_MS=300000
