{
  "name": "kb-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 SAG2（SQLite FTS5 + BM25 + JEV）的可动态增删改查知识库聊天机器人",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"node --watch server/index.js\" \"vite web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite web",
    "build": "vite build web",
    "start": "cross-env NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "unpdf": "^2.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "vite": "^5.4.11",
    "vue": "^3.5.13"
  }
}
